{
  "opencollection": "1.0.0",
  "info": {
    "name": "Olark JavaScript Box Chat API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "site_id",
      "value": "{{site_id}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Chat",
        "type": "folder"
      },
      "items": [
