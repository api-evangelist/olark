        "name": "Configure",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "olark.configure(key, value)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.olark.com/api/configure",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sets a chatbox configuration value before the widget initializes.\nExample: `olark.configure('system.hb_position', 'left');`.\n"
        },
        {
          "info": {
            "name": "olark.identify(siteId)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.olark.com/api/identify",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initializes the Olark chatbox with the supplied site identifier.\nExample: `olark.identify('1234-456-78-9810');`.\n"
        }
      ]
    },
